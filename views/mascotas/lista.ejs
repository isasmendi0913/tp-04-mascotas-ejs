<header class="cabecera-pagina">
  <div>
    <p class="etiqueta">CATÁLOGO</p>
    <h1><%= titulo %></h1>
  </div>
  <a class="boton" href="/mascotas/nueva">Agregar mascota</a>
</header>

<% if (mascotas.length === 0) { %>
  <p class="estado-vacio">No hay mascotas para mostrar.</p>
<% } else { %>
  <section class="grilla" aria-label="Mascotas disponibles">
    <% mascotas.forEach((mascota) => { %>
      <article class="tarjeta">
        <img src="/img/mascota.svg" alt="" width="60" height="60">
        <p class="etiqueta"><%= mascota.especie %></p>
        <h2><%= mascota.nombre %></h2>
        <p>Edad: <%= mascota.edad %> año<%= mascota.edad === 1 ? "" : "s" %></p>
        <p class="estado"><%= mascota.estado %></p>
        <a href="/mascotas/<%= mascota.id %>">Ver detalle</a>
      </article>
    <% }) %>
  </section>
<% } %>