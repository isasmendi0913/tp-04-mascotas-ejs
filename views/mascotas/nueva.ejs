<section class="panel-formulario">
  <p class="etiqueta">NUEVO INGRESO</p>
  <h1><%= titulo %></h1>

  <% if (error) { %>
    <p class="error" role="alert"><%= error %></p>
  <% } %>

  <form action="/mascotas" method="post" class="formulario">
    <label for="nombre">Nombre</label>
    <input
      id="nombre"
      name="nombre"
      type="text"
      value="<%= valores.nombre ?? '' %>"
      required
    >

    <label for="especie">Especie</label>
    <input
      id="especie"
      name="especie"
      type="text"
      value="<%= valores.especie ?? '' %>"
      required
    >

    <label for="edad">Edad (en años)</label>
    <input
      id="edad"
      name="edad"
      type="number"
      min="0"
      step="1"
      value="<%= valores.edad ?? '' %>"
      required
    >

    <label for="estado">Estado</label>
    <select id="estado" name="estado" required>
      <option value="">-- Seleccionar estado --</option>
      <option value="En adopción" <%= valores.estado === 'En adopción' ? 'selected' : '' %>>En adopción</option>
      <option value="Reservada" <%= valores.estado === 'Reservada' ? 'selected' : '' %>>Reservada</option>
      <option value="Adoptada" <%= valores.estado === 'Adoptada' ? 'selected' : '' %>>Adoptada</option>
      <!-- <option value="error" <%= valores.estado === 'error' ? 'selected' : '' %>>error</option> -->
    </select>

    <label for="descripcion">Descripción</label>
    <textarea
      id="descripcion"
      name="descripcion"
      rows="5"
      required
    ><%= valores.descripcion ?? '' %></textarea>

    <button type="submit">Guardar mascota</button>
  </form>
</section>